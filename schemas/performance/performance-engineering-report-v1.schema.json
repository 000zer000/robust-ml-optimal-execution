{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "performance-engineering-report-v1.schema.json",
  "type": "object",
  "required": [
    "schema_version", "step", "research_status", "hardware", "cpp_matching",
    "model_inference", "python_cpp_boundary", "latency_injection", "cuda_decision",
    "historical_execution_latency_impact", "gate_j_status", "scientific_boundary"
  ],
  "properties": {
    "schema_version": {"const": "performance-engineering-report-v1"},
    "step": {"const": 30},
    "research_status": {"const": "engineering_machine_specific_non_research"},
    "hardware": {"type": "object"},
    "cpp_matching": {"type": "object", "minProperties": 1},
    "model_inference": {"type": "object", "minProperties": 1},
    "python_cpp_boundary": {"type": "object"},
    "latency_injection": {"type": "object"},
    "cuda_decision": {"type": "object"},
    "historical_execution_latency_impact": {"const": "blocked_gate_c"},
    "gate_j_status": {"type": "string"},
    "scientific_boundary": {"type": "array", "minItems": 1}
  },
  "additionalProperties": true
}
