{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/robust-execution/quarantine-manifest-v1.schema.json",
  "title": "Quarantine manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "step", "validation_id", "source_run_id", "policy", "issues", "quarantined_days"],
  "properties": {
    "schema_version": {"const": 1},
    "step": {"const": 13},
    "validation_id": {"type": "string", "minLength": 1},
    "source_run_id": {"type": "string", "minLength": 1},
    "policy": {"const": "preserve_raw_never_repair_primary_history"},
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "scope", "detail", "quarantine", "day", "symbol", "connection_id", "message_index", "received_utc_ns", "relative_path"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "severity": {"enum": ["critical", "warning"]},
          "scope": {"type": "string", "minLength": 1},
          "detail": {"type": "string", "minLength": 1},
          "quarantine": {"type": "boolean"},
          "day": {"type": ["string", "null"]},
          "symbol": {"type": ["string", "null"]},
          "connection_id": {"type": ["string", "null"]},
          "message_index": {"type": ["integer", "null"], "minimum": 0},
          "received_utc_ns": {"type": ["integer", "null"], "minimum": 0},
          "relative_path": {"type": ["string", "null"]}
        }
      }
    },
    "quarantined_days": {"type": "array", "items": {"type": "string", "format": "date"}, "uniqueItems": true}
  }
}
