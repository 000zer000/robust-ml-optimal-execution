{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/robust-execution/day-admission-decision-v1.schema.json",
  "title": "Day admission decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "day", "structural_status", "admission_status", "reasons", "total_messages",
    "depth_messages", "trade_messages", "first_received_utc_ns", "last_received_utc_ns",
    "critical_issue_count", "warning_count"
  ],
  "properties": {
    "day": {"type": "string", "format": "date"},
    "structural_status": {"enum": ["valid", "invalid"]},
    "admission_status": {"enum": ["admitted", "quarantined", "fixture_valid_not_admissible", "not_admissible"]},
    "reasons": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "total_messages": {"type": "integer", "minimum": 0},
    "depth_messages": {
      "type": "object", "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "trade_messages": {
      "type": "object", "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "first_received_utc_ns": {"type": ["integer", "null"], "minimum": 0},
    "last_received_utc_ns": {"type": ["integer", "null"], "minimum": 0},
    "critical_issue_count": {"type": "integer", "minimum": 0},
    "warning_count": {"type": "integer", "minimum": 0}
  }
}
