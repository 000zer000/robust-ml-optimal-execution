{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/robust-execution/raw-capture-manifest-v1.schema.json",
  "title": "Raw capture manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "step",
    "run_id",
    "venue_id",
    "data_origin",
    "symbols",
    "status",
    "started_utc_ns",
    "ended_utc_ns",
    "planned_duration_seconds",
    "actual_duration_seconds",
    "pilot_72h_complete",
    "websocket_url",
    "rest_base",
    "compression",
    "exact_raw_payload_preserved",
    "research_specification_changed",
    "paid_data_used",
    "software_version",
    "runtime",
    "capture_config_sha256",
    "total_messages",
    "total_raw_payload_bytes",
    "total_uncompressed_bytes",
    "total_compressed_bytes",
    "connections",
    "artifacts",
    "symbol_diagnostics",
    "errors",
    "publication"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "step": {
      "const": 12
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "venue_id": {
      "const": "binance_spot"
    },
    "symbols": {
      "const": [
        "BTCUSDT",
        "ETHUSDT"
      ]
    },
    "status": {
      "enum": [
        "complete",
        "pilot_incomplete",
        "aborted"
      ]
    },
    "started_utc_ns": {
      "type": "integer",
      "minimum": 0
    },
    "ended_utc_ns": {
      "type": "integer",
      "minimum": 0
    },
    "planned_duration_seconds": {
      "const": 259200
    },
    "actual_duration_seconds": {
      "type": "number",
      "minimum": 0
    },
    "pilot_72h_complete": {
      "type": "boolean"
    },
    "websocket_url": {
      "type": "string",
      "pattern": "^wss://"
    },
    "rest_base": {
      "const": "https://data-api.binance.vision"
    },
    "compression": {
      "const": "gzip"
    },
    "exact_raw_payload_preserved": {
      "const": true
    },
    "research_specification_changed": {
      "const": false
    },
    "paid_data_used": {
      "const": false
    },
    "total_messages": {
      "type": "integer",
      "minimum": 0
    },
    "total_uncompressed_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "total_compressed_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "relative_path",
          "content_type",
          "compression",
          "uncompressed_bytes",
          "compressed_bytes",
          "record_count",
          "sha256"
        ],
        "properties": {
          "relative_path": {
            "type": "string",
            "minLength": 1
          },
          "content_type": {
            "type": "string",
            "minLength": 1
          },
          "compression": {
            "const": "gzip"
          },
          "uncompressed_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "compressed_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "record_count": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "symbol_diagnostics": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "symbol",
          "snapshots",
          "buffered_events",
          "applied_events",
          "ignored_events",
          "duplicate_events",
          "gaps",
          "malformed_events",
          "crossed_books",
          "resynchronizations",
          "synchronized",
          "synchronized_intervals"
        ]
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_market_data_public",
        "credentials_stored",
        "redistribution_cleared"
      ],
      "properties": {
        "raw_market_data_public": {
          "const": false
        },
        "credentials_stored": {
          "const": false
        },
        "redistribution_cleared": {
          "const": false
        }
      }
    },
    "total_raw_payload_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "data_origin": {
      "enum": [
        "live_binance",
        "synthetic_transport_fixture"
      ]
    },
    "software_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python",
        "implementation",
        "platform",
        "byteorder"
      ],
      "properties": {
        "python": {
          "type": "string",
          "minLength": 1
        },
        "implementation": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "byteorder": {
          "enum": [
            "little",
            "big"
          ]
        }
      }
    },
    "capture_config_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "pilot_72h_complete": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "const": "complete"
          },
          "actual_duration_seconds": {
            "minimum": 259200
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "data_origin": {
            "const": "synthetic_transport_fixture"
          }
        }
      },
      "then": {
        "properties": {
          "pilot_72h_complete": {
            "const": false
          },
          "status": {
            "const": "pilot_incomplete"
          }
        }
      }
    }
  ]
}
