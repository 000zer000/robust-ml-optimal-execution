{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "feature_names", "classes", "hidden_units", "alpha", "scaler_mean", "scaler_scale", "coefs", "intercepts"],
  "properties": {
    "schema_version": {"const": "imitation-policy-artifact-v1"},
    "feature_names": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "classes": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "hidden_units": {"type": "integer", "minimum": 2},
    "alpha": {"type": "number", "exclusiveMinimum": 0},
    "scaler_mean": {"type": "array", "items": {"type": "number"}},
    "scaler_scale": {"type": "array", "items": {"type": "number", "exclusiveMinimum": 0}},
    "coefs": {"type": "array", "minItems": 2, "maxItems": 2},
    "intercepts": {"type": "array", "minItems": 2, "maxItems": 2}
  }
}
