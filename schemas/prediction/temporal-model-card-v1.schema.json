{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/robust-execution/temporal-model-card-v1.schema.json",
  "title": "Step 23 temporal model card",
  "type": "object",
  "required": [
    "schema_version",
    "step",
    "family",
    "horizon",
    "feature_names",
    "sequence_length",
    "hyperparameters",
    "selected_epoch",
    "scaler_fit_segment",
    "calibration_segment",
    "parameter_count",
    "research_status",
    "selected_as_final_model",
    "selected_as_primary_horizon",
    "locked_research_test_opened"
  ],
  "properties": {
    "schema_version": {"const": "temporal-model-card-v1"},
    "step": {"const": 23},
    "family": {"const": "causal_conv1d_lstm"},
    "horizon": {"enum": ["250ms", "1s", "5s"]},
    "feature_names": {"type": "array", "minItems": 20, "maxItems": 20, "items": {"type": "string"}},
    "sequence_length": {"type": "integer", "minimum": 2},
    "conv_kernel_size": {"type": "integer", "minimum": 2},
    "hyperparameters": {"type": "object"},
    "selected_epoch": {"type": "integer", "minimum": 1},
    "scaler_fit_segment": {"const": "train_only"},
    "calibration_segment": {"const": "calibration_only"},
    "parameter_count": {"type": "integer", "minimum": 1},
    "research_status": {"const": "synthetic_validation_only_non_research"},
    "selected_as_final_model": {"const": false},
    "selected_as_primary_horizon": {"const": false},
    "engineering_holdout_used_for_selection": {"const": false},
    "decision_proxy_used_for_selection": {"const": false},
    "locked_research_test_opened": {"const": false}
  },
  "additionalProperties": true
}
